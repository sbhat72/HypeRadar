# Copy this file to .env and fill in your values.
# Spring Boot loads .env automatically via spring.config.import in application.properties.

DATABASE_URL=jdbc:postgresql://<host>:<port>/<db>
DATABASE_USERNAME=<username>
DATABASE_PASSWORD=<password>

REDIS_URL=redis://<host>:<port>

# Clerk — get from dashboard.clerk.com → API Keys
# CLERK_JWKS_URI and CLERK_ISSUER already have dev defaults in application.properties.
# Override here only if you switch Clerk apps.
CLERK_JWKS_URI=https://coherent-doberman-64.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://coherent-doberman-64.clerk.accounts.dev

ALPHA_VANTAGE_API_KEY=<your-key>

# Optional — Resend email service (defaults to placeholder if unset)
RESEND_API_KEY=<your-key>
